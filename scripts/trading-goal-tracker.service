[Unit]
Description=Trading Goal Tracker (API + Frontend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/server/apps/Trading-Goal-Tracker/artifacts/api-server
ExecStart=/usr/bin/env node --enable-source-maps /home/server/apps/Trading-Goal-Tracker/artifacts/api-server/dist/index.mjs
Environment=PORT=5000
Environment=NODE_ENV=production
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-goal-tracker

[Install]
WantedBy=default.target
